NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public business contact used only to build click-to-chat WhatsApp links.
# International format, digits only (Nigeria example: 2348012345678).
NEXT_PUBLIC_SUPPORT_WHATSAPP_NUMBER=

# Server-only. Never prefix with NEXT_PUBLIC_ and never expose to browser code.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Default question source: internal | aloc | aloc_station
# Set this exactly once. WAEC requires aloc_station — the legacy `aloc` adapter
# is JAMB-only, so any other value leaves WAEC unavailable in onboarding.
#
# This is the default, not the whole story: WAEC Biology, Chemistry, Physics and
# Agricultural Science are routed to `sdash` by features/questions/routing.ts,
# because ALOC Station has no verified WAEC inventory for them. Every other exam
# and subject — all of JAMB, and the other eleven WAEC subjects — uses the value
# below. Do not set this to `sdash`.
QUESTION_PROVIDER=aloc_station

# Legacy ALOC provider (M7). Server-only: never prefix with NEXT_PUBLIC_.
# Obtain a token from https://questions.aloc.com.ng after creating an account.
ALOC_ACCESS_TOKEN=
ALOC_BASE_URL=https://questions.aloc.com.ng/api/v2

# ALOC Station provider. Server-only: never prefix with NEXT_PUBLIC_.
# Free keys are for non-commercial prototyping and require provider attribution.
ALOC_STATION_API_KEY=
ALOC_STATION_BASE_URL=https://dev.aloc.com.ng/api/v1

# Intent-driven MASTER AI explanations. All values are server-only.
AI_EXPLANATIONS_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=12000
RATE_LIMIT_AI_EXPLANATION_BURST=2
RATE_LIMIT_AI_EXPLANATION_PER_HOUR=120

# Paystack monetization (M9). Placeholders only — put real keys in .env.local,
# which is git-ignored, and in the Vercel project settings.
#
# PAYSTACK_SECRET_KEY is server-only: never prefix it with NEXT_PUBLIC_ and
# never import it from a client component. The key prefix also decides which
# Paystack world this deployment settles against (sk_test_ vs sk_live_), so a
# live webhook can never activate a transaction opened with test keys.
PAYSTACK_SECRET_KEY=sk_test_YOUR_KEY
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_KEY

# Used to build Paystack callback URLs. Configured rather than taken from the
# request Host header, which a forged request controls.
# NEXT_PUBLIC_APP_URL is set above.

# Optional overrides for the billing limiters.
RATE_LIMIT_BILLING_CHECKOUT_BURST=5
RATE_LIMIT_BILLING_CHECKOUT_PER_HOUR=20
RATE_LIMIT_BILLING_VERIFY_BURST=12
RATE_LIMIT_BILLING_VERIFY_PER_HOUR=120
RATE_LIMIT_CLASS_LEAD_BURST=3
RATE_LIMIT_CLASS_LEAD_PER_HOUR=10

# Note: the AI daily allowance is no longer an environment variable. It is a
# plan entitlement (3/day Free, 20/day Master) defined in features/billing/plans.ts.

# Sdash provider. Server-only: never prefix with NEXT_PUBLIC_, and never put it
# in a query string — the adapter sends it as the `AccessToken` header.
#
# Serves four WAEC subjects only: Biology, Chemistry, Physics and Agricultural
# Science. Nothing selects it through QUESTION_PROVIDER; subject-level routing
# does. Without this key those four subjects are hidden from onboarding and
# Practice rather than offered and then failing.
SDASH_API_KEY=
SDASH_BASE_URL=https://sdashapi.com/api/v1

# Whether this deployment's Sdash credential is a Sandbox one. Defaults to true,
# so a deployment that forgets it loses a filter rather than serving a broken
# session. Sandbox answers each subject from a single examination year, so year
# selection is turned off for the four Sdash-backed subjects while it is true.
#
# Sandbox is for Preview/staging and controlled testing only: 2,000 credits,
# restricted inventory, one year per subject. Do not open the four Sdash-backed
# subjects to all students on it. Set this to false only once a paid/approved
# plan is in place, and redeploy — these values are read at build time, so a
# change made in the hosting dashboard does nothing until the next deployment.
# See SDASH-COVERAGE-NOTES.md for the two-stage rollout.
SDASH_SANDBOX=true

# Legacy key names are still accepted as a fallback:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   SUPABASE_SERVICE_ROLE_KEY      -> SUPABASE_SECRET_KEY
